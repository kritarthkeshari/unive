# Copy to .env and adjust as needed. Sensible defaults are used if unset.
PORT=4000
JWT_SECRET=change-me-in-production

# MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name to use inside the cluster
MONGODB_DB=univenture

# Comma-separated list of allowed CORS origins (frontend dev server)
CLIENT_ORIGIN=http://localhost:5173
